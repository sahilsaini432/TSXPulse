# Discord webhook for signal delivery (required for strategies + discovery output)
DISCORD_WEBHOOK_URL=

# Phase-2 paid data providers (leave blank for yfinance default)
FMP_API_KEY=
EODHD_API_KEY=

# Live trading safety toggle. Default 0. Only set to 1 when switching broker.mode to ibkr.
ENABLE_LIVE_TRADING=0

# --- Discovery pipeline (optional) ---
# Required if discovery.enabled=true in config.yaml.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Get a key at https://app.tavily.com/  (1,000 free searches/month, no card)
TAVILY_API_KEY=